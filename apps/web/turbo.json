{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["@glfonline/sanity-client#build", "@glfonline/shopify-client#build"],
			"env": ["NODE_ENV", "SENTRY_AUTH_TOKEN", "SENTRY_UPLOAD", "WORKERS_CI_COMMIT_SHA"],
			"outputs": [".cache/**", ".wrangler/**", "build/**", "public/build/**"]
		},
		"check:lint": {
			"env": ["ENCRYPTION_KEY", "RESEND_API_KEY", "TURNSTILE_SECRET_KEY"]
		},
		"check:types": {
			"dependsOn": ["@glfonline/sanity-client#build", "@glfonline/shopify-client#build"]
		},
		"test:browser": {
			"dependsOn": ["@glfonline/sanity-client#build", "@glfonline/shopify-client#build"]
		},
		"test:e2e": {
			"extends": false
		},
		"test:unit": {
			"dependsOn": ["@glfonline/sanity-client#build", "@glfonline/shopify-client#build"]
		}
	}
}
