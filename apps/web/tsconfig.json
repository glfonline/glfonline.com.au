{
	"extends": "@glfonline/tsconfig/react-app",
	"include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
	"exclude": ["node_modules"],
	"compilerOptions": {
		"types": ["node", "vite/client"],
		"rootDirs": [".", "./.react-router/types"],
		"paths": {
			"vitest": ["./node_modules/vitest"],
			"vitest/*": ["./node_modules/vitest/*"]
		}
	}
}
